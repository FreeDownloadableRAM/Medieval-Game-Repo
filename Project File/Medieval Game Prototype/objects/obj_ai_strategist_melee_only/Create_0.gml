// Change trainable units
can_train_sm = true;
can_train_pm = true;
can_train_rg = false;
can_train_kn = true;
can_train_ab = false;
can_train_hb = true;
can_train_mg = false;
can_train_nc = false;
can_train_cp = false;

// reinforcement properties
reinf_kn_amount = 2;
reinf_sm_amount = 4;
reinf_pm_amount = 4;

lstand_hb_amount = 1;
reinf_kn_amount = 2;
reinf_pm_amount = 3;